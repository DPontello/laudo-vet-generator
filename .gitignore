# Contexto local do Claude Code (não versionado a pedido do time)
CLAUDE.md
.claude/

# Runtime PHP local (baixado para rodar os testes; não faz parte do projeto)
/.tooling/

# PHP / Composer
/vendor/
composer.lock
*.log

# Artefatos: PDFs gerados e imagens anexadas nunca vão pro Git.
# (As imagens são efêmeras; os PDFs são arquivados localmente em data/laudos/,
#  que já cai na regra /data/ abaixo — histórico da médica, fora do versionamento.)
/storage/tmp/
/public/laudos-gerados/
*.pdf
!docs/referencia/*.pdf

# Dados do usuário: checklists personalizados e laudos arquivados (data/laudos/).
/data/

# Pacote de distribuição gerado (montar-pacote.sh/.bat)
/dist/

# Ambiente / segredos
.env
.env.*
!.env.example

# Sistema operacional
.DS_Store
Thumbs.db

# Editores / IDE
.idea/
.vscode/
*.swp
